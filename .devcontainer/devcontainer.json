{
  "name": "web-tune-handson",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/web-tune-handson",
  "overrideCommand": false,
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "ラーメンRunner",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.watcherExclude": {
          "**/vendor/**": true,
          "**/results/*.json": true
        }
      },
      "extensions": [
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client"
      ]
    }
  },
  "postCreateCommand": "sh .devcontainer/wait-ready.sh",
  "waitFor": "postCreateCommand"
}
